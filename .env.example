# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://seu-app.vercel.app)
APP_URL="https://seu-app.vercel.app"

# ASAAS GATEWAY CONFIGURATION (Vercel Environment Variables)
# Obtain in: asaas.com > Configurações > Integrações > Gerar Chave de API
ASAAS_API_KEY="MY_ASAAS_API_KEY"

# ASAAS_ENV: 'sandbox' for test/homologation, or 'production' for live payments
ASAAS_ENV="sandbox"

# ASAAS_WEBHOOK_TOKEN: Optional secret token configured in Asaas Webhook settings
ASAAS_WEBHOOK_TOKEN="my_webhook_secret_token"
